# ===== Mnemos secrets — NEVER commit this file =====
# Copy to .env (gitignored) and fill in what you have. All keys optional.

# --- Primary: Nebius Token Factory (OpenAI-compatible) ---
# Get $25 free credits with code NEBIUS-DEVPOST-GLOBAL26 at
# https://nebius.com/promo-code?utm_promo_event_code=2026-devpost-global-ai-hack
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Model tiers. On boot Mnemos re-reads GET /v1/models and heals any ID the
# catalog no longer serves, so these are starting points, not hard deps.
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_FRONTIER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Multimodal tier used for screenshot/whiteboard memories (leave blank to disable)
NEBIUS_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
# Set to 1 to stop the /no_think toggle being injected (measures reasoning tokens)
NEBIUS_KEEP_REASONING=

# --- Free fallbacks (all have free tiers, no credit card) ---
# OpenRouter: https://openrouter.ai/keys (free models, e.g. nvidia/nemotron-nano-9b-v2:free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# NVIDIA NIM: https://build.nvidia.com (free 1000 credits)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# --- Optional tools ---
# Tavily: https://tavily.com (web search for the agent; BBDEVPOST promo)
TAVILY_API_KEY=
# Public URL of this app (enables outbound fetch tool in sandboxed hosts)
PUBLIC_BASE_URL=
